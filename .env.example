# LLM Configuration (for metadata extraction)
# LLM 配置（用于元数据提取）
LLM_API_KEY=sk-your-api-key-here
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen-plus
PROVIDER=openai_sdk

# OCR Configuration (using Alibaba Cloud vision model)
# OCR 配置（使用阿里云视觉模型）
OCR_METHOD=vision
OCR_PROVIDER=openai_sdk
OCR_MODEL=qwen-vl-max
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_API_KEY_ENV=LLM_API_KEY

# Path Configuration
# 路径配置
ROOT_DIR=./pdf
OUT_DIR=./output

# Processing Configuration (Optional)
# 处理配置（可选）
# MAX_WORKERS=10
# MAX_RECORDS=0
# MAX_PAGES=20
# SCAN_DOI_PAGES=20

# Classification Configuration (Optional)
# 分类配置（可选）
# AUTO_CLASSIFY=true
# NUM_CATEGORIES=20
# PREDEFINED_CATEGORIES=Genomics,AI-Biomedicine,Drug-Discovery

# Supplement Merging (Optional)
# 补充材料合并（可选）
# MERGE_SUPPLEMENTS=true
